<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0e1014">
<title>雅思背单词 · IELTS Words</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0e1014;--card:#171a21;--card2:#1e222b;--line:#2a2f3a;
  --text:#e8ecf3;--muted:#8b93a5;--accent:#4f8cff;--accent2:#7aa9ff;
  --ok:#34d399;--bad:#f87171;
}
html,body{margin:0;padding:0}
body{
  background:var(--bg);color:var(--text);min-height:100vh;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  display:flex;flex-direction:column;align-items:center;
}
#app{width:100%;max-width:560px;flex:1;display:flex;flex-direction:column;padding-bottom:86px}

/* ---------- 顶栏 ---------- */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 20px 10px;
}
.logo{font-weight:700;font-size:18px;letter-spacing:.5px}
.logo span{color:var(--accent)}
.streak{
  font-size:13px;color:var(--muted);background:var(--card);
  border:1px solid var(--line);padding:6px 12px;border-radius:999px;
}

/* ---------- 视图 ---------- */
.main{flex:1;padding:0 16px}
.view{animation:fade .25s ease}
.hidden{display:none !important}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ---------- 进度条 ---------- */
.bar-wrap{margin-bottom:14px}
.bar-head{display:flex;justify-content:space-between;font-size:12.5px;color:var(--muted);margin-bottom:7px}
.bar{height:7px;background:var(--card2);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  transition:width .35s cubic-bezier(.4,0,.2,1)}

/* ---------- 卡片 ---------- */
.card{
  background:var(--card);border:1px solid var(--line);border-radius:20px;
  padding:22px 20px 20px;box-shadow:0 12px 34px rgba(0,0,0,.28);
}
.card-head{display:flex;gap:8px;margin-bottom:18px}
.pill{font-size:11.5px;padding:4px 11px;border-radius:99px;
  background:rgba(79,140,255,.14);color:var(--accent2);border:1px solid rgba(79,140,255,.28)}
.pill.dim{background:var(--card2);color:var(--muted);border-color:var(--line)}
.zh{font-size:25px;font-weight:650;line-height:1.4;margin-bottom:12px}
.en{font-size:15px;color:#b9c1d1;line-height:1.65;margin-bottom:6px}
.en .blank{color:var(--accent2);letter-spacing:2px;font-weight:600}
.hint{font-size:13px;color:#c9a24a;margin-top:10px;line-height:1.6;word-break:break-all}
.hint:empty{display:none}

.answer{
  width:100%;margin-top:20px;padding:15px 16px;font-size:19px;letter-spacing:1px;
  background:var(--card2);border:1.5px solid var(--line);border-radius:14px;
  color:var(--text);outline:none;transition:border-color .2s,box-shadow .2s;
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
}
.answer:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(79,140,255,.13)}
.answer:disabled{opacity:.75}
.answer::placeholder{color:#5c6478;font-family:inherit;letter-spacing:0}

.fb{margin-top:14px;font-size:14px;line-height:1.6;min-height:0}
.fb.ok{color:var(--ok)}
.fb.bad{color:var(--bad)}
.fb:empty{display:none}

.btns{display:flex;gap:10px;margin-top:18px}
.btns.center{justify-content:center}
.btn{
  flex:1;padding:13px 16px;border-radius:13px;border:1px solid transparent;
  font-size:15px;font-weight:600;cursor:pointer;transition:.18s;font-family:inherit;
}
.btn:active{transform:scale(.975)}
.btn.primary{background:linear-gradient(135deg,var(--accent),#3d6fe0);color:#fff;
  box-shadow:0 6px 18px rgba(79,140,255,.28)}
.btn.ghost{background:var(--card2);color:#c3cad9;border-color:var(--line)}
.btn.ghost:hover{border-color:#3a4150}
.btn.danger{background:rgba(248,113,113,.12);color:var(--bad);border-color:rgba(248,113,113,.3)}

/* ---------- 完成页 ---------- */
#finishArea{text-align:center;padding:44px 22px;background:var(--card);
  border:1px solid var(--line);border-radius:20px}
.finish-emoji{font-size:52px;margin-bottom:10px}
#finishArea h2{margin:6px 0 8px;font-size:21px}
#finishArea p{color:var(--muted);font-size:14px;margin:4px 0;line-height:1.7}

/* ---------- 底部导航 ---------- */
.tabbar{
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);
  width:100%;max-width:560px;display:flex;
  background:rgba(18,21,27,.94);backdrop-filter:blur(14px);
  border-top:1px solid var(--line);padding:8px 0 calc(8px + env(safe-area-inset-bottom));
}
.tab{
  flex:1;background:none;border:none;color:#666e80;font-size:11.5px;
  display:flex;flex-direction:column;align-items:center;gap:3px;
  padding:5px 0;cursor:pointer;font-family:inherit;transition:color .2s;
}
.tab span{font-size:19px;line-height:1}
.tab.active{color:var(--accent)}

/* ---------- 统计 ---------- */
h2.page-title{font-size:19px;margin:6px 0 16px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;
  padding:16px 16px 18px;margin-bottom:14px}
.panel-title{font-size:14px;font-weight:650;margin-bottom:12px}
.muted{color:var(--muted);font-size:12.5px;line-height:1.7;margin:0 0 10px}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px}
.stat .k{font-size:11.5px;color:var(--muted);margin-bottom:6px}
.stat .v{font-size:24px;font-weight:700}
.stat .v small{font-size:12px;color:var(--muted);font-weight:500;margin-left:3px}

.week{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.day{background:var(--card2);border-radius:11px;padding:9px 0;text-align:center;
  border:1px solid var(--line)}
.day span{display:block;font-size:10.5px;color:var(--muted);margin-bottom:4px}
.day i{font-style:normal;font-size:13px;color:#3d4452}
.day.on{background:rgba(52,211,153,.12);border-color:rgba(52,211,153,.35)}
.day.on i{color:var(--ok)}

.distrow{display:flex;align-items:center;gap:9px;margin-bottom:8px;font-size:11.5px}
.distrow .lb{width:52px;color:var(--muted);flex-shrink:0}
.distrow .track{flex:1;height:8px;background:var(--card2);border-radius:99px;overflow:hidden}
.distrow .track i{display:block;height:100%;border-radius:99px;
  background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .4s}
.distrow .nm{width:32px;text-align:right;color:var(--muted);flex-shrink:0}

/* ---------- 设置 ---------- */
.levels{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.lvbtn{padding:11px 0;border-radius:11px;border:1px solid var(--line);
  background:var(--card2);color:#b6bdcc;font-size:13px;font-weight:600;
  cursor:pointer;font-family:inherit;transition:.16s}
.lvbtn:hover{border-color:#3a4150}
.lvbtn.on{background:linear-gradient(135deg,var(--accent),#3d6fe0);color:#fff;
  border-color:transparent;box-shadow:0 5px 14px rgba(79,140,255,.3)}

.row{display:flex;align-items:center;gap:14px}
input[type=range]{flex:1;-webkit-appearance:none;height:5px;border-radius:99px;
  background:var(--card2);outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;
  border-radius:50%;background:var(--accent);cursor:pointer;
  box-shadow:0 2px 8px rgba(79,140,255,.5)}
input[type=range]::-moz-range-thumb{width:20px;height:20px;border:none;border-radius:50%;
  background:var(--accent);cursor:pointer}
.num{width:38px;text-align:center;font-size:14px;font-weight:650;color:var(--accent2)}

.toast{
  position:fixed;left:50%;bottom:104px;transform:translate(-50%,14px);
  background:#232833;border:1px solid var(--line);color:var(--text);
  padding:10px 20px;border-radius:99px;font-size:13.5px;opacity:0;
  pointer-events:none;transition:.25s;z-index:99;white-space:nowrap;
}
.toast.show{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>
<div id="app">

  <header class="topbar">
    <div class="logo">IELTS <span>Words</span></div>
    <div class="streak" id="streakEl">🔥 0 天</div>
  </header>

  <main class="main">
    <!-- ===== 学习 ===== -->
    <section id="view-study" class="view">
      <div class="bar-wrap">
        <div class="bar-head"><span id="barLeft">准备中…</span><span id="barRight"></span></div>
        <div class="bar"><i id="barFill"></i></div>
      </div>

      <div id="cardArea">
        <div class="card">
          <div class="card-head">
            <span class="pill" id="pillMode">新词</span>
            <span class="pill dim" id="pillLv">Lv.1</span>
          </div>
          <div class="zh" id="zh"></div>
          <div class="en" id="en"></div>
          <div class="hint" id="hint"></div>
          <input id="answer" class="answer" type="text" autocomplete="off"
                 autocorrect="off" autocapitalize="none" spellcheck="false"
                 placeholder="输入英文单词" />
          <div class="fb" id="fb"></div>
          <div class="btns">
            <button class="btn ghost" id="btnHint">提示</button>
            <button class="btn primary" id="btnSubmit">提交</button>
            <button class="btn primary hidden" id="btnNext">继续</button>
          </div>
        </div>
      </div>

      <div id="finishArea" class="hidden">
        <div class="finish-emoji" id="finishEmoji">🎉</div>
        <h2 id="finishTitle">今日任务完成</h2>
        <p id="finishDesc"></p>
        <div class="btns center" style="max-width:340px;margin:22px auto 0">
          <button class="btn ghost" id="btnExtra">再来一组</button>
          <button class="btn primary" id="btnStats">查看统计</button>
        </div>
      </div>
    </section>

    <!-- ===== 统计 ===== -->
    <section id="view-stats" class="view hidden"></section>

    <!-- ===== 设置 ===== -->
    <section id="view-settings" class="view hidden"></section>
  </main>

  <nav class="tabbar">
    <button class="tab active" data-view="study"><span>📖</span>学习</button>
    <button class="tab" data-view="stats"><span>📊</span>统计</button>
    <button class="tab" data-view="settings"><span>⚙️</span>设置</button>
  </nav>
</div>

<div class="toast" id="toast"></div>

<script>
/* ==========================================================
   雅思词库（10 个难度等级，每级 12 词）
   格式： 单词 | 中文释义 | 例句（___ 为挖空处） | 难度等级
   ========================================================== */
const RAW_WORDS = `
abandon|放弃，抛弃|They had to ___ the car in the snow.|1
absorb|吸收；使全神贯注|Plants ___ water through their roots.|1
abstract|抽象的；摘要|Beauty is an ___ concept.|1
academic|学术的；学业的|She has a strong ___ background.|1
accurate|准确的，精确的|The report must be ___ and fair.|1
