{
  "name": "words-desktop",
  "version": "1.0.0",
  "description": "VOCABULARY —— 万词记忆系统桌面版",
  "main": "main.js",
  "author": "illudew",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.illudew.words",
    "productName": "VOCABULARY",
    "files": [
      "main.js",
      {
        "from": "../index.html"
      },
      {
        "from": "../words.json"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VOCABULARY-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "VOCABULARY-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "VOCABULARY-${version}.${ext}"
    }
  }
}
